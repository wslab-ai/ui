{
  "name": "@workstarlab/ui",
  "version": "0.2.1",
  "description": "Design tokens, action styles, and small Workstar components for Workstar Lab.",
  "type": "module",
  "license": "MIT",
  "author": "Workstar Lab <hello@workstarlab.com>",
  "homepage": "https://github.com/wslab-ai/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wslab-ai/ui.git"
  },
  "bugs": {
    "url": "https://github.com/wslab-ai/ui/issues"
  },
  "keywords": [
    "workstar",
    "ui",
    "design-system",
    "accessibility",
    "css"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "workstar": "^0.1.0 || ^0.2.4-beta.0"
  },
  "peerDependenciesMeta": {
    "workstar": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "styles"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./styles/tokens.css",
    "./actions.css": "./styles/actions.css"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "verify": "npm run format:check && npm run check && npm test && npm run build && npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "workstar": "0.1.0"
  }
}
